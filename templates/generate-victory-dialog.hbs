<div class="pfai-form pfai-generate-form">

  {{#unless hasApiKey}}
    <p class="pfai-warning">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize 'PFAI.Generate.NoKeyWarning'}}
    </p>
  {{/unless}}

  <p class="pfai-note">
    <i class="fa-solid fa-circle-info"></i> {{localize 'PFAI.Research.GenerateNote'}}
  </p>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Victory.Objective'}}</span>
    <textarea name="objective" rows="2" placeholder="{{localize 'PFAI.Victory.ObjectivePlaceholder'}}"
              {{#if busy}}disabled{{/if}} autofocus></textarea>
    <small>{{localize 'PFAI.Victory.ObjectiveHint'}}</small>
  </label>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Victory.Situation'}}</span>
    <textarea name="premise" rows="3" placeholder="{{localize 'PFAI.Victory.SituationPlaceholder'}}"
              {{#if busy}}disabled{{/if}}></textarea>
    <small>{{localize 'PFAI.Victory.SituationHint'}}</small>
  </label>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Victory.Goal'}}</span>
    <textarea name="goal" rows="2" placeholder="{{localize 'PFAI.Victory.GoalPlaceholder'}}"
              {{#if busy}}disabled{{/if}}></textarea>
  </label>

  <fieldset class="pfai-fieldset">
    <legend>{{localize 'PFAI.Victory.HowItRuns'}}</legend>
    <div class="pfai-field-row">
      <label class="pfai-field"><span>{{localize 'PFAI.Victory.Structure'}}</span>
        <select name="structure" {{#if busy}}disabled{{/if}}>
          {{#each structures}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <small>{{localize 'PFAI.Victory.StructureHint'}}</small></label>
      <label class="pfai-field"><span>{{localize 'PFAI.Victory.Scale'}}</span>
        <select name="scale" {{#if busy}}disabled{{/if}}>
          {{#each scales}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} &mdash; {{goal}}</option>
          {{/each}}
        </select>
        <small>{{localize 'PFAI.Victory.ScaleHint'}}</small></label>
    </div>
    <label class="pfai-field"><span>{{localize 'PFAI.Victory.Failure'}}</span>
      <textarea name="failure" rows="2" {{#if busy}}disabled{{/if}}
                placeholder="{{localize 'PFAI.Victory.FailurePlaceholder'}}"></textarea>
      <small>{{localize 'PFAI.Victory.FailureHint'}}</small></label>
  </fieldset>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.TitleField'}}</span>
      <input type="text" name="title" placeholder="{{localize 'PFAI.Generate.TitlePlaceholder'}}"
             {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.BaseDC'}}</span>
      <input type="number" name="baseDC" min="1" max="60" step="1" value="{{baseDC}}" {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Generate.BaseDCHint'}}</small>
    </label>
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field">
      <span>{{localize 'PFAI.Influence.PartyLevel'}}</span>
      <input type="number" name="level" min="0" max="25" step="1" value="{{level}}" {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Influence.PartySize'}}</span>
      <input type="number" name="partySize" min="1" max="10" step="1" value="{{partySize}}" {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.RoundLimit'}}</span>
      <input type="number" name="roundLimit" min="0" step="1" value="0" {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Generate.AutoHint'}}</small>
    </label>
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.Tone'}}</span>
      <input type="text" name="tone" placeholder="{{localize 'PFAI.Generate.TonePlaceholder'}}" {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.Language'}}</span>
      <input type="text" name="language" value="{{language}}" {{#if busy}}disabled{{/if}}>
    </label>
  </div>

  <footer class="pfai-generate-footer">
    <span class="pfai-model">{{localize 'PFAI.Generate.UsingModel'}} <code>{{model}}</code></span>
    {{#if busy}}
      <span class="pfai-busy"><i class="fa-solid fa-spinner fa-spin"></i> {{localize 'PFAI.Generate.Working'}}</span>
      <button type="button" data-action="cancel">{{localize 'PFAI.Generate.Cancel'}}</button>
    {{else}}
      <button type="button" data-action="cancel">{{localize 'PFAI.Close'}}</button>
      <button type="button" data-action="saveBrief" data-tooltip="{{localize 'PFAI.Brief.Hint'}}">
        <i class="fa-solid fa-file-arrow-down"></i> {{localize 'PFAI.Brief.Save'}}
      </button>
      <button type="submit" class="pfai-primary" {{#unless hasApiKey}}disabled{{/unless}}>
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize 'PFAI.Victory.Submit'}}
      </button>
    {{/if}}
  </footer>

</div>
