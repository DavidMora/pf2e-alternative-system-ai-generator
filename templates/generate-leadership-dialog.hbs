<div class="pfai-form pfai-generate-form">

  {{#unless hasApiKey}}
    <p class="pfai-warning">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize 'PFAI.Generate.NoKeyWarning'}}
    </p>
  {{/unless}}

  <p class="pfai-note">
    <i class="fa-solid fa-circle-info"></i> {{localize 'PFAI.Leadership.GenerateNote'}}
  </p>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Leadership.Organization'}}</span>
    <textarea name="organization" rows="3" placeholder="{{localize 'PFAI.Leadership.OrganizationPlaceholder'}}"
              {{#if busy}}disabled{{/if}} autofocus></textarea>
    <small>{{localize 'PFAI.Leadership.OrganizationHint'}}</small>
  </label>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Leadership.Premise'}}</span>
    <textarea name="premise" rows="2" placeholder="{{localize 'PFAI.Leadership.PremisePlaceholder'}}"
              {{#if busy}}disabled{{/if}}></textarea>
  </label>

  <label class="pfai-field">
    <span>{{localize 'PFAI.Leadership.Goal'}}</span>
    <textarea name="goal" rows="2" placeholder="{{localize 'PFAI.Leadership.GoalPlaceholder'}}"
              {{#if busy}}disabled{{/if}}></textarea>
  </label>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.TitleField'}}</span>
      <input type="text" name="title" placeholder="{{localize 'PFAI.Generate.TitlePlaceholder'}}"
             {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Leadership.OrganizationLevel'}}</span>
      <input type="number" name="organizationLevel" min="1" max="20" step="1" value="{{organizationLevel}}"
             {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Leadership.OrganizationLevelHint'}}</small>
    </label>
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.BaseDC'}}</span>
      <input type="number" name="baseDC" min="1" max="60" step="1" value="{{baseDC}}" {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Generate.BaseDCHint'}}</small>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Influence.PartyLevel'}}</span>
      <input type="number" name="level" min="0" max="25" step="1" value="{{level}}" {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Influence.PartySize'}}</span>
      <input type="number" name="partySize" min="1" max="10" step="1" value="{{partySize}}" {{#if busy}}disabled{{/if}}>
    </label>
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.Tone'}}</span>
      <input type="text" name="tone" placeholder="{{localize 'PFAI.Generate.TonePlaceholder'}}" {{#if busy}}disabled{{/if}}>
    </label>
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.Language'}}</span>
      <input type="text" name="language" value="{{language}}" {{#if busy}}disabled{{/if}}>
    </label>
  </div>

  <footer class="pfai-generate-footer">
    <span class="pfai-model">{{localize 'PFAI.Generate.UsingModel'}} <code>{{model}}</code></span>
    {{#if busy}}
      <span class="pfai-busy"><i class="fa-solid fa-spinner fa-spin"></i> {{localize 'PFAI.Generate.Working'}}</span>
      <button type="button" data-action="cancel">{{localize 'PFAI.Generate.Cancel'}}</button>
    {{else}}
      <button type="button" data-action="cancel">{{localize 'PFAI.Close'}}</button>
      <button type="button" data-action="saveBrief" data-tooltip="{{localize 'PFAI.Brief.Hint'}}">
        <i class="fa-solid fa-file-arrow-down"></i> {{localize 'PFAI.Brief.Save'}}
      </button>
      <button type="submit" class="pfai-primary" {{#unless hasApiKey}}disabled{{/unless}}>
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize 'PFAI.Leadership.Submit'}}
      </button>
    {{/if}}
  </footer>

</div>
