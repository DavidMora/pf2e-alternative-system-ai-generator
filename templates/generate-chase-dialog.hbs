<div class="pfai-form pfai-generate-form">

  {{#unless hasApiKey}}
    <p class="pfai-warning">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize 'PFAI.Generate.NoKeyWarning'}}
    </p>
  {{/unless}}

  {{#if obstaclesOnly}}
    <p class="pfai-note">
      <i class="fa-solid fa-circle-info"></i>
      {{#if existingObstacles}}
        {{localize 'PFAI.Generate.RegenerateNote'}}
      {{else}}
        {{localize 'PFAI.Generate.FillNote'}}
      {{/if}}
    </p>
  {{/if}}

  <label class="pfai-field">
    <span>{{localize 'PFAI.Generate.Premise'}}</span>
    <textarea name="premise" rows="5" placeholder="{{localize 'PFAI.Generate.PremisePlaceholder'}}"
              {{#if busy}}disabled{{/if}} autofocus>{{premise}}</textarea>
    <small>{{localize 'PFAI.Generate.PremiseHint'}}</small>
  </label>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.TitleField'}}</span>
      <input type="text" name="title" value="{{title}}" placeholder="{{localize 'PFAI.Generate.TitlePlaceholder'}}"
             {{#if busy}}disabled{{/if}}>
    </label>

    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.BaseDC'}}</span>
      <input type="number" name="baseDC" min="1" max="60" step="1" value="{{baseDC}}" {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Generate.BaseDCHint'}}</small>
    </label>
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.ObstacleCount'}}</span>
      <input type="number" name="obstacleCount" min="0" max="10" step="1" value="0" {{#if busy}}disabled{{/if}}>
      <small>{{localize 'PFAI.Generate.AutoHint'}}</small>
    </label>

    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.Difficulty'}}</span>
      <select name="difficulty" {{#if busy}}disabled{{/if}}>
        {{#each difficulties as |difficulty|}}
          <option value="{{difficulty.value}}" {{#if (pfaiEq difficulty.value "auto")}}selected{{/if}}>
            {{difficulty.label}}
          </option>
        {{/each}}
      </select>
    </label>

    {{#unless obstaclesOnly}}
      <label class="pfai-field">
        <span>{{localize 'PFAI.Generate.RoundLimit'}}</span>
        <input type="number" name="roundLimit" min="0" step="1" value="0" {{#if busy}}disabled{{/if}}>
        <small>{{localize 'PFAI.Generate.AutoHint'}}</small>
      </label>
    {{/unless}}
  </div>

  <div class="pfai-field-row">
    <label class="pfai-field pfai-field-wide">
      <span>{{localize 'PFAI.Generate.Tone'}}</span>
      <input type="text" name="tone" placeholder="{{localize 'PFAI.Generate.TonePlaceholder'}}" {{#if busy}}disabled{{/if}}>
    </label>

    <label class="pfai-field">
      <span>{{localize 'PFAI.Generate.Language'}}</span>
      <input type="text" name="language" value="{{language}}" {{#if busy}}disabled{{/if}}>
    </label>
  </div>

  <footer class="pfai-generate-footer">
    <span class="pfai-model">{{localize 'PFAI.Generate.UsingModel'}} <code>{{model}}</code></span>
    {{#if busy}}
      <span class="pfai-busy"><i class="fa-solid fa-spinner fa-spin"></i> {{localize 'PFAI.Generate.Working'}}</span>
      <button type="button" data-action="cancel">{{localize 'PFAI.Generate.Cancel'}}</button>
    {{else}}
      <button type="button" data-action="cancel">{{localize 'PFAI.Close'}}</button>
      <button type="submit" class="pfai-primary" {{#unless hasApiKey}}disabled{{/unless}}>
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        {{#if obstaclesOnly}}{{localize 'PFAI.Chase.GenerateObstacles'}}{{else}}{{localize 'PFAI.Generate.Submit'}}{{/if}}
      </button>
    {{/if}}
  </footer>

</div>
