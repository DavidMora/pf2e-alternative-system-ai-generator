{{#with selectedInfluence}}
<header class="pfai-detail-header">
  <button type="button" class="pfai-icon" data-action="backInfluence" data-tooltip="{{localize 'PFAI.Back'}}">
    <i class="fa-solid fa-chevron-left"></i>
  </button>
  <h2 class="pfai-title">
    {{name}}
    {{#if showNpcSubtitle}}<span class="pfai-subtitle">{{npc.name}}</span>{{/if}}
    {{#if ai.generated}}<i class="fa-solid fa-wand-magic-sparkles pfai-ai-badge"></i>{{/if}}
  </h2>
  <div class="pfai-header-actions">
    {{#if ../isRealGM}}
      <button type="button" class="pfai-icon {{#if ../previewAsPlayer}}pfai-toggle-on{{/if}}"
              data-action="togglePlayerPreview" data-tooltip="{{localize 'PFAI.View.PreviewAsPlayer'}}">
        <i class="fa-solid {{#if ../previewAsPlayer}}fa-user-check{{else}}fa-user{{/if}}"></i>
      </button>
    {{/if}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon" data-action="toggleInfluenceHidden" data-influence-id="{{id}}"
              data-tooltip="{{#if hidden}}{{localize 'PFAI.View.ShowToPlayers'}}{{else}}{{localize 'PFAI.View.HideFromPlayers'}}{{/if}}">
        <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
      </button>
      <button type="button" class="pfai-icon pfai-danger" data-action="deleteInfluence" data-influence-id="{{id}}"
              data-tooltip="{{localize 'PFAI.View.Delete'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    {{/if}}
  </div>
</header>

<section class="pfai-status">
  <div class="pfai-status-item">
    <span class="pfai-label">{{localize 'PFAI.Chase.Round'}}</span>
    <span class="pfai-round">
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influenceRoundDelta" data-influence-id="{{id}}" data-delta="-1">&minus;</button>
      {{/if}}
      <strong>{{rounds.current}}</strong>{{#if rounds.max}} / {{rounds.max}}{{/if}}
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influenceRoundDelta" data-influence-id="{{id}}" data-delta="1">+</button>
      {{/if}}
    </span>
  </div>

  <div class="pfai-status-item">
    <span class="pfai-label">{{localize 'PFAI.Influence.Points'}}</span>
    <span class="pfai-round">
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influencePointDelta" data-influence-id="{{id}}" data-delta="-1">&minus;</button>
      {{/if}}
      <strong class="pfai-points-big">{{influencePoints}}</strong>
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influencePointDelta" data-influence-id="{{id}}" data-delta="1">+</button>
      {{/if}}
    </span>
  </div>

  {{#if nextThreshold}}
    <div class="pfai-status-item pfai-live-obstacle">
      <span class="pfai-label">{{localize 'PFAI.Influence.NextThreshold'}}</span>
      <span class="pfai-live-points">
        <strong>{{influencePoints}} / {{nextThreshold.points}}</strong>
        <span class="pfai-live-name">{{nextThreshold.name}}</span>
      </span>
    </div>
  {{else if allThresholdsReached}}
    <div class="pfai-flag pfai-flag-good">{{localize 'PFAI.Influence.FullyWonOver'}}</div>
  {{/if}}

  {{#if dcModifier}}
    <div class="pfai-status-item">
      <span class="pfai-label">{{localize 'PFAI.Influence.DCShift'}}</span>
      <strong class="{{#if (pfaiLt dcModifier 0)}}pfai-good{{else}}pfai-bad{{/if}}">
        {{#if (pfaiLt dcModifier 0)}}{{dcModifier}}{{else}}+{{dcModifier}}{{/if}}
      </strong>
    </div>
  {{/if}}

  {{#if outOfTime}}<div class="pfai-flag pfai-flag-bad">{{localize 'PFAI.Chase.OutOfTime'}}</div>{{/if}}

  {{#if ../isGM}}
    <div class="pfai-status-actions">
      <button type="button" data-action="influenceNextRound" data-influence-id="{{id}}">
        <i class="fa-solid fa-forward-step"></i> {{localize 'PFAI.Chase.NextRound'}}
      </button>
    </div>
  {{/if}}
</section>

<section class="pfai-panel pfai-npc-panel">
  <h3>{{localize 'PFAI.Influence.WhoTheyAre'}}{{#if npc.disposition}} <em class="pfai-disposition">{{npc.disposition}}</em>{{/if}}</h3>
  <div class="pfai-npc-stats">
    <span><span class="pfai-label">{{localize 'PFAI.Influence.Perception'}}</span> <strong>+{{perception}}</strong></span>
    <span><span class="pfai-label">{{localize 'PFAI.Influence.Will'}}</span> <strong>+{{will}}</strong></span>
    <span><span class="pfai-label">{{localize 'PFAI.Chase.BaseDC'}}</span> <strong>{{baseDC}}</strong></span>
  </div>
  <div class="pfai-prose">{{{enrichedNpcDescription}}}</div>
  {{#if ../isGM}}
    <div class="pfai-gm-inset">
      <span class="pfai-label">{{localize 'PFAI.Influence.WhatTheyWant'}}</span>
      <div class="pfai-prose">{{{enrichedNpcWants}}}</div>
    </div>
  {{/if}}
</section>

<section class="pfai-panel">
  <h3>{{localize 'PFAI.Influence.Situation'}}</h3>
  <div class="pfai-prose">{{{enrichedPremise}}}</div>
  {{#if enrichedGoal}}
    <p class="pfai-goal"><span class="pfai-label">{{localize 'PFAI.Influence.Goal'}}</span></p>
    <div class="pfai-prose">{{{enrichedGoal}}}</div>
  {{/if}}
</section>

{{#if ../isGM}}
  <section class="pfai-panel pfai-gm">
    <h3>{{localize 'PFAI.Chase.GmNotes'}}</h3>
    <div class="pfai-prose">{{{enrichedGmNotes}}}</div>
  </section>
{{/if}}

{{> pfaiInfluenceChecks entries=discoveries kind="discovery" collection="discoveries"
    title=(localize 'PFAI.Influence.Discoveries') hint=(localize 'PFAI.Influence.DiscoveriesHint')
    isGM=../isGM influenceId=id participants=participants}}

{{> pfaiInfluenceChecks entries=influenceSkills kind="influence" collection="influenceSkills"
    title=(localize 'PFAI.Influence.InfluenceSkills') hint=(localize 'PFAI.Influence.InfluenceSkillsHint')
    isGM=../isGM influenceId=id participants=participants
    hiddenCount=hiddenCounts.influenceSkills}}

<section class="pfai-panel">
  <h3>
    {{localize 'PFAI.Influence.Thresholds'}}
    {{#if hiddenCounts.thresholds}}<span class="pfai-hidden-count">{{hiddenCounts.thresholds}} {{localize 'PFAI.Influence.Undiscovered'}}</span>{{/if}}
  </h3>
  <ol class="pfai-thresholds">
    {{#each thresholds as |threshold|}}
      <li class="pfai-threshold {{#if threshold.reached}}is-reached{{/if}} {{#if threshold.hidden}}is-hidden{{/if}}">
        <span class="pfai-threshold-points">{{threshold.points}}</span>
        <div class="pfai-threshold-body">
          <strong>{{threshold.name}}</strong>
          <div class="pfai-prose">{{{threshold.enrichedDescription}}}</div>
        </div>
        {{#if ../../isGM}}
          <button type="button" class="pfai-icon pfai-hover-only" data-action="toggleReveal"
                  data-influence-id="{{../id}}" data-collection="thresholds" data-entry-id="{{threshold.id}}"
                  data-tooltip="{{#if threshold.hidden}}{{localize 'PFAI.Influence.Reveal'}}{{else}}{{localize 'PFAI.Influence.Conceal'}}{{/if}}">
            <i class="fa-solid {{#if threshold.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
          </button>
        {{/if}}
      </li>
    {{else}}
      <p class="pfai-empty">{{localize 'PFAI.Influence.NoThresholds'}}</p>
    {{/each}}
  </ol>
</section>

<section class="pfai-panel pfai-traits">
  {{> pfaiInfluenceTraits entries=weaknesses collection="weaknesses" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Weaknesses') tone="good" hiddenCount=hiddenCounts.weaknesses}}
  {{> pfaiInfluenceTraits entries=resistances collection="resistances" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Resistances') tone="bad" hiddenCount=hiddenCounts.resistances}}
  {{> pfaiInfluenceTraits entries=penalties collection="penalties" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Penalties') tone="bad"}}
</section>

<section class="pfai-panel">
  <h3>
    {{localize 'PFAI.Chase.Participants'}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon" data-action="addParticipants" data-chase-id="{{id}}"
              data-tooltip="{{localize 'PFAI.Chase.AddParticipantsHint'}}"><i class="fa-solid fa-user-plus"></i></button>
    {{/if}}
  </h3>
  <div class="pfai-roster pfai-roster-influence">
    <div class="pfai-roster-head">
      <span>{{localize 'PFAI.Chase.Participant'}}</span>
      <span>{{localize 'PFAI.Influence.Contributed'}}</span>
      <span>{{localize 'PFAI.Chase.Turn'}}</span>
    </div>
    {{#each participants as |participant|}}
      <div class="pfai-participant {{#if participant.hasActed}}has-acted{{/if}}">
        <span class="pfai-p-who">
          <img src="{{participant.img}}" alt="">
          <span class="pfai-p-name">{{participant.name}}</span>
          {{#if participant.hasActed}}
            <i class="fa-solid fa-check pfai-acted-mark" data-tooltip="{{localize 'PFAI.Chase.ActedTooltip'}}"></i>
          {{/if}}
        </span>
        <span class="pfai-p-points" data-tooltip="{{localize 'PFAI.Influence.ContributionTooltip'}} {{participant.contribution.successes}}/{{participant.contribution.rolls}}">
          <span class="pfai-tally {{#unless participant.contribution.rolls}}is-empty{{/unless}}">
            <i class="fa-solid fa-star"></i><strong>{{participant.contribution.total}}</strong>
            {{#if participant.contribution.discoveries}}
              <small><i class="fa-solid fa-magnifying-glass"></i>{{participant.contribution.discoveries}}</small>
            {{/if}}
          </span>
        </span>
        <span class="pfai-p-turn">
          {{#if participant.canRoll}}
            <span class="pfai-p-note">{{localize 'PFAI.Influence.RollFromLists'}}</span>
          {{else if participant.noActor}}
            <span class="pfai-p-note">{{localize 'PFAI.Roll.NoActorLinked'}}</span>
          {{else if participant.hasActed}}
            <span class="pfai-p-note">{{localize 'PFAI.Chase.Acted'}}</span>
          {{else}}
            <span class="pfai-p-note">{{localize 'PFAI.Roll.NotYours'}}</span>
          {{/if}}
          {{#if ../../isGM}}
            <button type="button" class="pfai-icon pfai-hover-only" data-action="toggleActed"
                    data-chase-id="{{../id}}" data-participant-id="{{participant.id}}"
                    data-tooltip="{{localize 'PFAI.Chase.ToggleActed'}}">
              <i class="fa-solid {{#if participant.hasActed}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
            </button>
          {{/if}}
        </span>
      </div>
    {{else}}
      <p class="pfai-empty">{{localize 'PFAI.Chase.NoParticipants'}}</p>
    {{/each}}
  </div>
</section>
{{/with}}
