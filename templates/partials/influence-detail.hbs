{{#with selectedInfluence}}
<header class="pfai-detail-header">
  <button type="button" class="pfai-icon" data-action="backInfluence" data-tooltip="{{localize 'PFAI.Back'}}">
    <i class="fa-solid fa-chevron-left"></i>
  </button>
  <h2 class="pfai-title">
    {{name}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon pfai-title-edit" data-action="editTitle"
              data-subsystem="influence" data-event-id="{{id}}"
              data-tooltip="{{localize 'PFAI.Chase.EditTitle'}}"><i class="fa-solid fa-pen"></i></button>
    {{/if}}
    {{#if showNpcSubtitle}}<span class="pfai-subtitle">{{npc.name}}</span>{{/if}}
    {{#if ai.generated}}<i class="fa-solid fa-wand-magic-sparkles pfai-ai-badge"></i>{{/if}}
  </h2>
  <div class="pfai-header-actions">
    {{#if ../isRealGM}}
      <button type="button" class="pfai-icon {{#if ../previewAsPlayer}}pfai-toggle-on{{/if}}"
              data-action="togglePlayerPreview" data-tooltip="{{localize 'PFAI.View.PreviewAsPlayer'}}">
        <i class="fa-solid {{#if ../previewAsPlayer}}fa-user-check{{else}}fa-user{{/if}}"></i>
      </button>
    {{/if}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon pfai-show-players" data-action="showToPlayers"
              data-subsystem="influence" data-event-id="{{id}}"
              data-tooltip="{{localize 'PFAI.View.ShowToPlayersHint'}}">
        <i class="fa-solid fa-tv"></i>
      </button>
      <button type="button" class="pfai-icon" data-action="toggleHidden"
              data-subsystem="influence" data-event-id="{{id}}"
              data-tooltip="{{#if hidden}}{{localize 'PFAI.View.ShowToPlayers'}}{{else}}{{localize 'PFAI.View.HideFromPlayers'}}{{/if}}">
        <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
      </button>
      <button type="button" class="pfai-icon" data-action="exportEvent"
              data-subsystem="influence" data-event-id="{{id}}"
              data-tooltip="{{localize 'PFAI.View.Export'}}">
        <i class="fa-solid fa-file-export"></i>
      </button>
      <button type="button" class="pfai-icon pfai-danger" data-action="deleteInfluence" data-influence-id="{{id}}"
              data-tooltip="{{localize 'PFAI.View.Delete'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    {{/if}}
  </div>
</header>

<section class="pfai-status">
  <div class="pfai-status-item">
    <span class="pfai-label">{{localize 'PFAI.Chase.Round'}}</span>
    <span class="pfai-round">
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influenceRoundDelta" data-influence-id="{{id}}" data-delta="-1">&minus;</button>
      {{/if}}
      <strong>{{rounds.current}}</strong>{{#if rounds.max}} / {{rounds.max}}{{/if}}
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influenceRoundDelta" data-influence-id="{{id}}" data-delta="1">+</button>
      {{/if}}
    </span>
  </div>

  <div class="pfai-status-item">
    <span class="pfai-label">{{localize 'PFAI.Influence.Points'}}</span>
    <span class="pfai-round">
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influencePointDelta" data-influence-id="{{id}}" data-delta="-1">&minus;</button>
      {{/if}}
      <strong class="pfai-points-big">{{influencePoints}}</strong>
      {{#if ../isGM}}
        <button type="button" class="pfai-step" data-action="influencePointDelta" data-influence-id="{{id}}" data-delta="1">+</button>
      {{/if}}
    </span>
  </div>

  {{#if nextThreshold}}
    <div class="pfai-status-item pfai-live-obstacle">
      <span class="pfai-label">{{localize 'PFAI.Influence.NextThreshold'}}</span>
      <span class="pfai-live-points">
        <strong>{{influencePoints}} / {{nextThreshold.points}}</strong>
        <span class="pfai-live-name">{{nextThreshold.name}}</span>
      </span>
    </div>
  {{else if allThresholdsReached}}
    <div class="pfai-flag pfai-flag-good">{{localize 'PFAI.Influence.FullyWonOver'}}</div>
  {{/if}}

  {{#if dcModifier}}
    <div class="pfai-status-item">
      <span class="pfai-label">{{localize 'PFAI.Influence.DCShift'}}</span>
      <strong class="{{#if (pfaiLt dcModifier 0)}}pfai-good{{else}}pfai-bad{{/if}}">
        {{#if (pfaiLt dcModifier 0)}}{{dcModifier}}{{else}}+{{dcModifier}}{{/if}}
      </strong>
    </div>
  {{/if}}

  {{#if outOfTime}}<div class="pfai-flag pfai-flag-bad">{{localize 'PFAI.Chase.OutOfTime'}}</div>{{/if}}

  {{#if ../isGM}}
    <div class="pfai-status-actions">
      <button type="button" data-action="influenceNextRound" data-influence-id="{{id}}">
        <i class="fa-solid fa-forward-step"></i> {{localize 'PFAI.Chase.NextRound'}}
      </button>
      <button type="button" data-action="toggleStarted" data-subsystem="influence" data-event-id="{{id}}">
        <i class="fa-solid {{#if started}}fa-pause{{else}}fa-play{{/if}}"></i>
        {{#if started}}{{localize 'PFAI.Chase.Pause'}}{{else}}{{localize 'PFAI.Chase.Start'}}{{/if}}
      </button>
    </div>
  {{/if}}
</section>

<section class="pfai-panel pfai-npc-panel">
  <h3>
    {{localize 'PFAI.Influence.WhoTheyAre'}}
    {{#if npc.disposition}} <em class="pfai-disposition">{{npc.disposition}}</em>{{/if}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon pfai-row-control" data-action="editStats"
              data-subsystem="influence" data-event-id="{{id}}"
              data-tooltip="{{localize 'PFAI.Influence.EditStats'}}"><i class="fa-solid fa-sliders"></i></button>
    {{/if}}
    {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="npc.description" data-label="PFAI.Influence.WhoTheyAre" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
  </h3>
  <div class="pfai-npc-stats">
    <span><span class="pfai-label">{{localize 'PFAI.Influence.Perception'}}</span> <strong>+{{perception}}</strong></span>
    <span><span class="pfai-label">{{localize 'PFAI.Influence.Will'}}</span> <strong>+{{will}}</strong></span>
    <span><span class="pfai-label">{{localize 'PFAI.Chase.BaseDC'}}</span> <strong>{{baseDC}}</strong></span>
  </div>
  <div class="pfai-prose">{{{enrichedNpcDescription}}}</div>
  {{#if ../isGM}}
    <div class="pfai-gm-inset">
      <span class="pfai-label">{{localize 'PFAI.Influence.WhatTheyWant'}}
        {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="npc.wants" data-label="PFAI.Influence.WhatTheyWant" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
      </span>
      <div class="pfai-prose">{{{enrichedNpcWants}}}</div>
    </div>
  {{/if}}
</section>

<section class="pfai-panel">
  <h3>{{localize 'PFAI.Influence.Situation'}}
    {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="premise" data-label="PFAI.Influence.Situation" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
  </h3>
  <div class="pfai-prose">{{{enrichedPremise}}}</div>
  {{#if ../isGM}}
    {{#unless enrichedGoal}}
      <p class="pfai-goal"><span class="pfai-label">{{localize 'PFAI.Influence.Goal'}}
        {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="goal" data-label="PFAI.Influence.Goal" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
      </span></p>
    {{/unless}}
  {{/if}}
  {{#if enrichedGoal}}
    <p class="pfai-goal"><span class="pfai-label">{{localize 'PFAI.Influence.Goal'}}
      {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="goal" data-label="PFAI.Influence.Goal" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
    </span></p>
    <div class="pfai-prose">{{{enrichedGoal}}}</div>
  {{/if}}
</section>

{{#if ../isGM}}
  <section class="pfai-panel pfai-gm">
    <h3>{{localize 'PFAI.Chase.GmNotes'}}
      {{#if ../isGM}}<button type="button" class="pfai-icon pfai-row-control" data-action="editText" data-subsystem="influence" data-event-id="{{id}}" data-field="gmNotes" data-label="PFAI.Chase.GmNotes" data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>{{/if}}
    </h3>
    <div class="pfai-prose">{{{enrichedGmNotes}}}</div>
  </section>
{{/if}}

{{> pfaiInfluenceChecks entries=discoveries kind="discovery" collection="discoveries"
    title=(localize 'PFAI.Influence.Discoveries') hint=(localize 'PFAI.Influence.DiscoveriesHint')
    isGM=../isGM influenceId=id participants=participants generating=../generatingObstacle generating=../generatingObstacle}}

{{> pfaiInfluenceChecks entries=influenceSkills kind="influence" collection="influenceSkills"
    title=(localize 'PFAI.Influence.InfluenceSkills') hint=(localize 'PFAI.Influence.InfluenceSkillsHint')
    isGM=../isGM influenceId=id participants=participants
    hiddenCount=hiddenCounts.influenceSkills}}

<section class="pfai-panel">
  <h3>
    {{localize 'PFAI.Influence.Thresholds'}}
    <i class="fa-solid fa-circle-info pfai-info" data-tooltip="{{localize 'PFAI.Influence.ThresholdsInfo'}}"></i>
    {{#if hiddenCounts.thresholds}}<span class="pfai-hidden-count">{{hiddenCounts.thresholds}} {{localize 'PFAI.Influence.Undiscovered'}}</span>{{/if}}
    {{#if ../isGM}}
      <span class="pfai-panel-actions">
        <button type="button" class="pfai-generate-obstacles" data-action="addThreshold" data-influence-id="{{id}}"
                data-tooltip="{{localize 'PFAI.Influence.AddThresholdHint'}}">
          <i class="fa-solid fa-plus"></i> {{localize 'PFAI.Chase.AddBlank'}}
        </button>
      </span>
    {{/if}}
  </h3>
  <ol class="pfai-thresholds">
    {{#each thresholds as |threshold|}}
      <li class="pfai-threshold {{#if threshold.reached}}is-reached{{/if}} {{#if threshold.hidden}}is-hidden{{/if}}">
        <span class="pfai-threshold-points">{{threshold.points}}</span>
        <div class="pfai-threshold-body">
          <strong>{{threshold.name}}</strong>
          <div class="pfai-prose">{{{threshold.enrichedDescription}}}</div>
        </div>
        {{#if ../../isGM}}
          <span class="pfai-trait-actions">
            <button type="button" class="pfai-icon pfai-row-control" data-action="toggleReveal"
                    data-influence-id="{{../id}}" data-collection="thresholds" data-entry-id="{{threshold.id}}"
                    data-tooltip="{{#if threshold.hidden}}{{localize 'PFAI.Influence.Reveal'}}{{else}}{{localize 'PFAI.Influence.Conceal'}}{{/if}}">
              <i class="fa-solid {{#if threshold.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
            </button>
            <button type="button" class="pfai-icon pfai-row-control" data-action="editThreshold"
                    data-influence-id="{{../id}}" data-entry-id="{{threshold.id}}"
                    data-tooltip="{{localize 'PFAI.Edit'}}"><i class="fa-solid fa-pen"></i></button>
            <button type="button" class="pfai-icon pfai-danger pfai-row-control" data-action="deleteThreshold"
                    data-influence-id="{{../id}}" data-entry-id="{{threshold.id}}"
                    data-tooltip="{{localize 'PFAI.View.Delete'}}"><i class="fa-solid fa-xmark"></i></button>
          </span>
        {{/if}}
      </li>
    {{else}}
      <p class="pfai-empty">{{localize 'PFAI.Influence.NoThresholds'}}</p>
    {{/each}}
  </ol>
</section>

<section class="pfai-panel pfai-traits">
  {{> pfaiInfluenceTraits entries=weaknesses collection="weaknesses" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Weaknesses') tone="good" hiddenCount=hiddenCounts.weaknesses
      info=(localize 'PFAI.Influence.WeaknessesInfo')}}
  {{> pfaiInfluenceTraits entries=resistances collection="resistances" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Resistances') tone="bad" hiddenCount=hiddenCounts.resistances
      info=(localize 'PFAI.Influence.ResistancesInfo')}}
  {{> pfaiInfluenceTraits entries=penalties collection="penalties" isGM=../isGM influenceId=id
      title=(localize 'PFAI.Influence.Penalties') tone="bad"
      info=(localize 'PFAI.Influence.PenaltiesInfo')}}
</section>

<section class="pfai-panel">
  <h3>
    {{localize 'PFAI.Chase.Participants'}}
    {{#if ../isGM}}
      <button type="button" class="pfai-icon" data-action="addParticipants" data-chase-id="{{id}}"
              data-tooltip="{{localize 'PFAI.Chase.AddParticipantsHint'}}"><i class="fa-solid fa-user-plus"></i></button>
    {{/if}}
  </h3>
  <div class="pfai-roster pfai-roster-influence pfai-dropzone"
       data-subsystem="influence" data-event-id="{{id}}">
    <div class="pfai-roster-head">
      <span>{{localize 'PFAI.Chase.Participant'}}</span>
      <span>{{localize 'PFAI.Chase.Points'}}</span>
      <span>{{localize 'PFAI.Chase.Turn'}}</span>
      <span></span>
    </div>
    {{#each participants as |participant|}}
      <div class="pfai-participant {{#if participant.hasActed}}has-acted{{/if}}">
        <span class="pfai-p-who">
          <img src="{{participant.img}}" alt="">
          <span class="pfai-p-name">{{participant.name}}</span>
          {{#if participant.hasActed}}
            <i class="fa-solid fa-check pfai-acted-mark" data-tooltip="{{localize 'PFAI.Chase.ActedTooltip'}}"></i>
          {{/if}}
        </span>

        <span class="pfai-p-points"
              data-tooltip="{{localize 'PFAI.Influence.ContributionTooltip'}} {{participant.successCount}}/{{participant.rollCount}}">
          {{#if participant.canAward}}
            <button type="button" class="pfai-step pfai-hover-only" data-action="awardInfluence"
                    data-influence-id="{{../id}}" data-participant-id="{{participant.id}}" data-delta="-1"
                    data-tooltip="{{localize 'PFAI.Chase.RemoveSuccess'}}">&minus;</button>
          {{/if}}
          <span class="pfai-tally {{#unless participant.hasContributed}}is-empty{{/unless}}">
            <i class="fa-solid fa-star"></i><strong>{{participant.contributedTotal}}</strong>
            {{#if participant.discoveryCount}}
              <small><i class="fa-solid fa-magnifying-glass"></i>{{participant.discoveryCount}}</small>
            {{/if}}
          </span>
          {{#if participant.canAward}}
            <button type="button" class="pfai-step pfai-hover-only" data-action="awardInfluence"
                    data-influence-id="{{../id}}" data-participant-id="{{participant.id}}" data-delta="1"
                    data-tooltip="{{localize 'PFAI.Chase.AwardSuccess'}}">+</button>
          {{/if}}
        </span>

        <span class="pfai-p-turn">
          {{#if participant.canRoll}}
            <select class="pfai-roll-option" aria-label="{{localize 'PFAI.Roll.PickSkill'}}">
              {{#each participant.rollOptions as |option|}}
                <option value="{{option.id}}" data-kind="{{option.kind}}">{{option.label}} DC {{option.dc}}</option>
              {{/each}}
            </select>
            <button type="button" class="pfai-roll-button {{#if participant.isReroll}}pfai-reroll{{/if}}"
                    data-action="rollInfluence" data-influence-id="{{../id}}"
                    data-participant-id="{{participant.id}}"
                    data-tooltip="{{#if participant.isReroll}}{{localize 'PFAI.Roll.RerollHint'}}{{else}}{{localize 'PFAI.Roll.Roll'}}{{/if}}">
              <i class="fa-solid fa-dice-d20"></i>
            </button>
          {{else if participant.noActor}}
            <span class="pfai-p-note">{{localize 'PFAI.Roll.NoActorLinked'}}</span>
          {{else if participant.missingActor}}
            <span class="pfai-p-note is-bad">{{localize 'PFAI.Roll.ActorMissing'}}</span>
          {{else if participant.hasActed}}
            <span class="pfai-p-note">{{localize 'PFAI.Chase.Acted'}}</span>
          {{else}}
            <span class="pfai-p-note">{{localize 'PFAI.Roll.NotYours'}}</span>
          {{/if}}
        </span>

        <span class="pfai-p-end">
          {{#if ../../isGM}}
            <button type="button" class="pfai-icon pfai-row-control" data-action="toggleActed"
                    data-subsystem="influence" data-event-id="{{../id}}" data-participant-id="{{participant.id}}"
                    data-tooltip="{{localize 'PFAI.Chase.ToggleActed'}}">
              <i class="fa-solid {{#if participant.hasActed}}fa-circle-check{{else}}fa-circle{{/if}}"></i>
            </button>
            <button type="button" class="pfai-icon pfai-danger pfai-row-control" data-action="removeParticipant"
                    data-subsystem="influence" data-event-id="{{../id}}" data-participant-id="{{participant.id}}"
                    data-tooltip="{{localize 'PFAI.Chase.RemoveParticipant'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          {{/if}}
        </span>
      </div>
    {{/each}}
    {{#unless participants.length}}
      <p class="pfai-empty pfai-drop-hint">
        {{#if ../isGM}}
          <i class="fa-solid fa-hand-pointer"></i> {{localize 'PFAI.Chase.DropHint'}}
        {{else}}
          {{localize 'PFAI.Chase.NoParticipants'}}
        {{/if}}
      </p>
    {{/unless}}
  </div>
</section>
{{/with}}
